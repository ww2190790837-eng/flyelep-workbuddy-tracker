{
  "version": 2,
  "builds": [
    { "src": "server.mjs", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/t.gif", "dest": "server.mjs" },
    { "src": "/api/(.*)", "dest": "server.mjs" },
    { "src": "/admin", "dest": "server.mjs" },
    { "src": "/admin/(.*)", "dest": "server.mjs" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
